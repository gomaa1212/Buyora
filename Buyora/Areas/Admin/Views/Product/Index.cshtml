@model PageResult<GetProductsListViewModel>
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = _localizer["products"];
    var categories = ViewBag.Categories as IEnumerable<GetCategoriesListViewModel>;
    var selectedCategory = Context.Request.Query["categoryName"].ToString();
}

<div class="buyora-page-wrapper">
    <div class="buyora-card buyora-header-banner p-4 mb-4">
        <div class="row align-items-center gy-3">
            <div class="col-12 col-md-7 d-flex align-items-center gap-3">
                <div class="buyora-icon-box">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1 text-buyora-blue">@_localizer["products"]</h4>
                    <p class="text-muted mb-0 small">@_localizer["productssubtitle"]</p>
                </div>
            </div>
            <div class="col-12 col-md-5 text-md-end">
                <a asp-action="Create" class="btn btn-buyora-accent d-inline-flex align-items-center justify-content-center gap-2 w-100 w-md-auto">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>@_localizer["createproduct"]</span>
                </a>
            </div>
        </div>
    </div>

    <div class="buyora-card p-3 p-md-4 mb-4">
        <div class="buyora-search-wrapper position-relative">
            <span class="buyora-search-icon">
                <i class="bi bi-search"></i>
            </span>
            <input type="search"
                   id="searchInput"
                   class="form-control buyora-search-input"
                   asp-for="@Model.Search"
                   placeholder="@_localizer["searchproductsplaceholder"]"
                   autocomplete="off" />
            <div id="searchSpinner" class="buyora-search-spinner d-none">
                <div class="spinner-border spinner-border-sm text-buyora-orange" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <button type="button" id="clearSearchBtn" class="buyora-search-clear @(string.IsNullOrWhiteSpace(Model?.Search) ? "d-none" : "")" aria-label="Clear">
                <i class="bi bi-x-circle-fill"></i>
            </button>
        </div>

        @if (categories != null && categories.Any())
        {
            <div class="buyora-category-filter-bar mt-3 pt-3 border-top">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-1">
                        <i class="bi bi-funnel-fill text-buyora-orange"></i>
                        <span>@_localizer["categories"]</span>
                    </span>
                </div>

                <div class="buyora-cat-scroll d-flex align-items-center gap-2 overflow-auto py-2 px-1">
                    <a asp-controller="Product"
                       asp-area="Admin"
                       asp-action="Index"
                       asp-route-categoryName=""
                       asp-route-search="@Model.Search"
                       class="buyora-cat-pill @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")">
                        <span class="buyora-cat-pill-avatar">
                            <i class="bi bi-grid-fill"></i>
                        </span>
                        <span class="buyora-cat-pill-name">@_localizer["viewall"]</span>
                    </a>

                    @foreach (var cat in categories.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder))
                    {
                        var isActiveCat = string.Equals(selectedCategory, cat.Name, StringComparison.OrdinalIgnoreCase);
                        <a asp-controller="Product"
                           asp-area="Admin"
                           asp-action="Index"
                           asp-route-categoryName="@cat.Name"
                           asp-route-search="@Model.Search"
                           class="buyora-cat-pill @(isActiveCat ? "active" : "")">
                            <span class="buyora-cat-pill-avatar">
                                @(string.IsNullOrEmpty(cat.Name) ? "B" : cat.Name.Substring(0, 1).ToUpper())
                            </span>
                            <span class="buyora-cat-pill-name">@cat.Name</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <div id="productList" class="buyora-products-container">
        <partial name="_DisplayProductsPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            let timer;
            let currentRequest;
            const currentCategory = '@Html.Raw(selectedCategory)';
            const searchUrl = '@Url.Action("Index", "Product")';
            const $searchInput = $("#searchInput");
            const $spinner = $("#searchSpinner");
            const $clearBtn = $("#clearSearchBtn");
            const $productList = $("#productList");

            function triggerSearch(searchTerm) {
                if (currentRequest) currentRequest.abort();

                $spinner.removeClass("d-none");
                $clearBtn.addClass("d-none");
                $productList.addClass("buyora-loading-fade");

                currentRequest = $.ajax({
                    url: searchUrl,
                    type: "GET",
                    data: { categoryName: currentCategory, search: searchTerm },
                    success: function(result) {
                        $productList.html(result);
                    },
                    error: function(xhr, status, error) {
                        if (status !== "abort")
                            console.error("AJAX Error: " + status + " - " + error);
                    },
                    complete: function(xhr, status) {
                        if (status !== "abort") {
                            $spinner.addClass("d-none");
                            $productList.removeClass("buyora-loading-fade");
                            if ($searchInput.val().trim().length > 0) {
                                $clearBtn.removeClass("d-none");
                            }
                        }
                    }
                });
            }

            $searchInput.on("input", function() {
                const searchTerm = $(this).val().trim();

                if (searchTerm.length > 0) {
                    $clearBtn.removeClass("d-none");
                } else {
                    $clearBtn.addClass("d-none");
                }

                clearTimeout(timer);
                timer = setTimeout(function() {
                    triggerSearch(searchTerm);
                }, 400);
            });

            $clearBtn.on("click", function() {
                $searchInput.val("").trigger("focus");
                $clearBtn.addClass("d-none");
                clearTimeout(timer);
                triggerSearch("");
            });
        });
    </script>
}