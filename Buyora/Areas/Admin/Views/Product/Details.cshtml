@model GetProductByIdViewModel
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = Model.Name;
    var main = Model.ProductImages?.FirstOrDefault(x => x.IsMain);
    var others = Model.ProductImages?.Where(x => !x.IsMain).ToList() ?? new List<ProductImageViewModel>();

    var hasDiscount = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value > 0 && Model.DiscountPrice.Value < Model.Price;
    var discountPercentage = hasDiscount
        ? (int)Math.Round(((Model.Price - Model.DiscountPrice!.Value) / Model.Price) * 100)
        : 0;
    var savedAmount = hasDiscount ? (Model.Price - Model.DiscountPrice!.Value) : 0;
}

<div class="buyora-page-wrapper">
    <div class="buyora-card buyora-header-banner p-4 mb-4">
        <div class="row align-items-center gy-3">
            <div class="col-12 col-md-6 d-flex align-items-center gap-3">
                <div class="buyora-icon-box">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1 text-buyora-blue">@_localizer["productdetails"]</h4>
                    <p class="text-muted mb-0 small">@_localizer["productdetailssubtitle"]</p>
                </div>
            </div>
            <div class="col-12 col-md-6 text-md-end">
                <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn buyora-action-btn btn-edit d-inline-flex align-items-center gap-1 px-3 py-2">
                            <i class="bi bi-pencil-square"></i>
                            <span>@_localizer["edit"]</span>
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn buyora-action-btn btn-delete d-inline-flex align-items-center gap-1 px-3 py-2">
                            <i class="bi bi-trash3"></i>
                            <span>@_localizer["delete"]</span>
                        </a>
                    }
                    <a asp-action="Index" class="btn buyora-btn-outline d-inline-flex align-items-center gap-1 px-3 py-2">
                        <i class="bi bi-arrow-left-short fs-5 buyora-rtl-flip"></i>
                        <span>@_localizer["back"]</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="buyora-card p-4 p-lg-5">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-6">
                <div class="buyora-details-gallery">
                    <div class="buyora-main-stage position-relative mb-3">
                        @if (hasDiscount)
                        {
                            <span class="buyora-discount-badge fs-6 px-3 py-1">
                                -@discountPercentage% @_localizer["off"]
                            </span>
                        }

                        @if (main != null && !string.IsNullOrEmpty(main.Url))
                        {
                            <img id="activeProductImage" src="/@main.Url" alt="@Model.Name" class="buyora-stage-img" />
                        }
                        else if (others.Any())
                        {
                            <img id="activeProductImage" src="/@others.First().Url" alt="@Model.Name" class="buyora-stage-img" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-image display-3"></i>
                                <span class="small mt-2">@_localizer["noimageavailable"]</span>
                            </div>
                        }
                    </div>

                    @if (main != null || others.Any())
                    {
                        <div class="buyora-thumb-strip d-flex align-items-center gap-2 overflow-auto pb-2">
                            @if (main != null && !string.IsNullOrEmpty(main.Url))
                            {
                                <button type="button"
                                        class="buyora-thumb-item active position-relative"
                                        onclick="changeMainImage(this, '/@main.Url')">
                                    <img src="/@main.Url" alt="@Model.Name" />
                                </button>
                            }

                            @foreach (var item in others)
                            {
                                <button type="button"
                                        class="buyora-thumb-item"
                                        onclick="changeMainImage(this, '/@item.Url')">
                                    <img src="/@item.Url" alt="@Model.Name" />
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-6 d-flex flex-column">
                <div class="mb-2">
                    <span class="badge rounded-pill bg-primary-subtle text-buyora-blue px-3 py-1 fw-bold">
                        <i class="bi bi-patch-check-fill me-1"></i> @_localizer["originalproduct"]
                    </span>
                </div>

                <h2 class="fw-extrabold text-dark mb-3">@Model.Name</h2>

                <div class="buyora-price-box p-3 rounded-4 mb-4">
                    @if (hasDiscount)
                    {
                        <div class="d-flex flex-wrap align-items-baseline gap-3">
                            <span class="buyora-details-price">@Model.DiscountPrice!.Value.ToString("N2") <small class="fs-6">@_localizer["currency"]</small></span>
                            <span class="text-muted text-decoration-line-through fs-5 fw-semibold">@Model.Price.ToString("N2") @_localizer["currency"]</span>
                        </div>
                        <div class="mt-2">
                            <span class="buyora-save-pill">
                                <i class="bi bi-lightning-charge-fill"></i> @_localizer["yousave"] @savedAmount.ToString("N2") @_localizer["currency"] (@discountPercentage%)
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="buyora-details-price">@Model.Price.ToString("N2") <small class="fs-6">@_localizer["currency"]</small></span>
                    }
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-buyora-blue text-uppercase small mb-2">
                        <i class="bi bi-text-paragraph text-buyora-orange me-1"></i> @_localizer["description"]
                    </h6>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="buyora-description-text mb-0">@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic small mb-0">@_localizer["nodescription"]</p>
                    }
                </div>

                <div class="mt-auto pt-4 border-top">
                    <form asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" method="post" class="row g-3 align-items-center m-0 js-add-to-cart-form">
                        <input type="hidden" name="productId" value="@Model.Id" />

                        <div class="col-12 col-sm-4">
                            <div class="buyora-qty-selector d-flex align-items-center justify-content-between">
                                <button type="button" class="buyora-qty-btn" onclick="updateQty(-1)" aria-label="Decrease Quantity">
                                    <i class="bi bi-dash-lg"></i>
                                </button>
                                <input id="productQtyInput" type="number" name="count" value="1" min="1" max="99" class="buyora-qty-input" readonly />
                                <button type="button" class="buyora-qty-btn" onclick="updateQty(1)" aria-label="Increase Quantity">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>

                        <div class="col-12 col-sm-8">
                            <button type="submit" class="btn btn-buyora-accent btn-add-to-cart w-100 py-3 d-flex align-items-center justify-content-center gap-2 fs-6">
                                <i class="bi bi-cart-plus-fill fs-5 cart-btn-icon"></i>
                                <span class="cart-btn-text">@_localizer["addtocart"]</span>
                            </button>
                        </div>
                    </form>

                    <div class="row g-2 mt-4 pt-3 border-top text-center text-sm-start">
                        <div class="col-12 col-sm-4 d-flex align-items-center justify-content-center justify-content-sm-start gap-2">
                            <i class="bi bi-truck text-buyora-orange fs-5"></i>
                            <span class="small fw-semibold text-muted">@_localizer["fastdelivery"]</span>
                        </div>
                        <div class="col-12 col-sm-4 d-flex align-items-center justify-content-center justify-content-sm-start gap-2">
                            <i class="bi bi-shield-lock text-buyora-blue fs-5"></i>
                            <span class="small fw-semibold text-muted">@_localizer["securepayment"]</span>
                        </div>
                        <div class="col-12 col-sm-4 d-flex align-items-center justify-content-center justify-content-sm-start gap-2">
                            <i class="bi bi-arrow-repeat text-buyora-orange fs-5"></i>
                            <span class="small fw-semibold text-muted">@_localizer["easyreturns"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeMainImage(thumbButton, imageUrl) {
            const mainImg = document.getElementById('activeProductImage');
            if (!mainImg) return;

            mainImg.style.opacity = '0.35';
            setTimeout(() => {
                mainImg.src = imageUrl;
                mainImg.style.opacity = '1';
            }, 140);

            document.querySelectorAll('.buyora-thumb-item').forEach(btn => btn.classList.remove('active'));
            thumbButton.classList.add('active');
        }

        function updateQty(step) {
            const qtyInput = document.getElementById('productQtyInput');
            if (!qtyInput) return;

            let current = parseInt(qtyInput.value) || 1;
            current += step;
            if (current < 1) current = 1;
            if (current > 99) current = 99;
            qtyInput.value = current;
        }
    </script>
}