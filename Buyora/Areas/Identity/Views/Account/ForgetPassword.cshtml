@model ForgetPasswordViewModel
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = _localizer["forgotpassword"];
}

<div class="buyora-auth-wrapper py-3 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="buyora-card buyora-auth-card overflow-hidden">
                <div class="row g-0">
                    <div class="col-12 col-lg-5 buyora-auth-visual d-flex flex-column justify-content-between p-4 p-xl-5 text-white position-relative">
                        <div class="position-relative z-2 text-center text-lg-start">
                            <span class="buyora-auth-badge d-inline-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-key-fill text-buyora-orange"></i>
                                <span>@_localizer["passwordrecovery"]</span>
                            </span>
                            <h3 class="fw-extrabold mb-2">@_localizer["forgotpassword"]</h3>
                            <p class="text-white-50 small mb-0">@_localizer["forgotpasswordsidebarsubtitle"]</p>
                        </div>

                        <div class="buyora-auth-img-stage my-3 position-relative z-2 text-center">
                            <img src="/ForgetPassword.jpeg" alt="Forgot Password" class="buyora-auth-img img-fluid" />
                        </div>

                        <div class="position-relative z-2">
                            <div class="d-flex align-items-center gap-3 p-3 rounded-4 buyora-auth-perks">
                                <div class="buyora-perk-icon">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 small text-white">@_localizer["quickandsecure"]</h6>
                                    <span class="text-white-50" style="font-size: 0.78rem;">@_localizer["quickandsecuresub"]</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-7 p-4 p-sm-5 bg-white d-flex flex-column justify-content-center">
                        <div class="mb-4">
                            <div class="buyora-mail-pulse-badge d-inline-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-question-circle-fill"></i>
                                <span>@_localizer["dontworry"]</span>
                            </div>
                            <h3 class="fw-extrabold text-buyora-blue mb-2">@_localizer["resetpasswordtitle"]</h3>
                            <p class="text-muted small mb-0">@_localizer["resetpasswordsubtitle"]</p>
                        </div>

                        <form asp-action="ForgetPassword" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small mb-3" role="alert"></div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Email" class="form-label buyora-label">
                                        <i class="bi bi-envelope-fill text-buyora-blue me-1"></i> @_localizer["email"]
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control buyora-input" placeholder="name@example.com" dir="ltr" autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
                                </div>

                                <div class="col-12">
                                    <div class="buyora-steps-box p-3 rounded-4 d-flex align-items-start gap-3">
                                        <i class="bi bi-info-circle-fill text-buyora-orange fs-5 mt-1"></i>
                                        <p class="text-muted mb-0" style="font-size: 0.82rem; line-height: 1.6;">
                                            @_localizer["resetpasswordhint"]
                                        </p>
                                    </div>
                                </div>

                                <div class="col-12 pt-2">
                                    <button type="submit" class="btn btn-buyora-accent btn-add-to-cart w-100 py-3 d-flex align-items-center justify-content-center gap-2 fs-6">
                                        <i class="bi bi-send-fill fs-5 cart-btn-icon"></i>
                                        <span class="cart-btn-text">@_localizer["sendresetlink"]</span>
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <span class="text-muted small">@_localizer["rememberedpassword"]</span>
                            <a asp-action="Login" class="fw-bold text-buyora-blue text-decoration-none ms-1 buyora-auth-link d-inline-flex align-items-center gap-1">
                                <span>@_localizer["backtologin"]</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}