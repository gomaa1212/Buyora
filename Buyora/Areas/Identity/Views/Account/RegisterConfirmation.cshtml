@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = _localizer["checkyouremail"];
    var userEmail = ViewBag.Email as string ?? TempData["Email"] as string;
}

<div class="buyora-auth-wrapper py-3 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="buyora-card buyora-auth-card overflow-hidden">
                <div class="row g-0">
                    <div class="col-12 col-lg-5 buyora-auth-visual d-flex flex-column justify-content-center align-items-center p-4 p-xl-5 text-white position-relative">
                        <div class="buyora-auth-img-stage position-relative z-2 text-center my-auto">
                            <img src="/CheckEmail.png" alt="Check Your Email" class="buyora-auth-img img-fluid" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-7 p-4 p-sm-5 bg-white d-flex flex-column justify-content-center">
                        <div class="mb-3">
                            <span class="buyora-mail-pulse-badge d-inline-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-envelope-check-fill"></i>
                                <span>@_localizer["almostthere"]</span>
                            </span>
                            <h3 class="fw-extrabold text-buyora-blue mb-2">@_localizer["checkyouremail"]</h3>
                            <p class="text-muted mb-0">@_localizer["checkemailsubtitle"]</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(userEmail))
                        {
                            <div class="buyora-email-target-box d-flex align-items-center gap-3 p-3 rounded-4 my-3">
                                <div class="buyora-email-target-icon">
                                    <i class="bi bi-send-check-fill"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <span class="text-muted d-block" style="font-size: 0.78rem;">@_localizer["verificationlinksentto"]</span>
                                    <strong class="text-buyora-blue text-truncate d-block" dir="ltr">@userEmail</strong>
                                </div>
                            </div>
                        }

                        <div class="buyora-steps-box p-3 p-sm-4 rounded-4 my-3">
                            <h6 class="fw-bold text-buyora-blue small text-uppercase mb-3">
                                <i class="bi bi-list-check text-buyora-orange me-1"></i> @_localizer["nextsteps"]
                            </h6>

                            <div class="d-flex align-items-start gap-3 mb-3">
                                <span class="buyora-step-num">1</span>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 small">@_localizer["step1title"]</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.82rem;">@_localizer["step1desc"]</p>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3 mb-3">
                                <span class="buyora-step-num">2</span>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 small">@_localizer["step2title"]</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.82rem;">@_localizer["step2desc"]</p>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <span class="buyora-step-num">3</span>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 small">@_localizer["step3title"]</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.82rem;">@_localizer["step3desc"]</p>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-12 col-sm-6">
                                <a href="https://mail.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-buyora-accent btn-add-to-cart w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-envelope-open-fill fs-5 cart-btn-icon"></i>
                                    <span class="cart-btn-text">@_localizer["openemailapp"]</span>
                                </a>
                            </div>
                            <div class="col-12 col-sm-6">
                                <a asp-action="Login" class="btn buyora-btn-outline w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-box-arrow-in-right fs-5"></i>
                                    <span>@_localizer["backtologin"]</span>
                                </a>
                            </div>
                        </div>

                        <div class="text-center mt-4 pt-3 border-top">
                            <i class="bi bi-info-circle text-buyora-orange me-1"></i>
                            <span class="text-muted small">@_localizer["checkspamfolder"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>