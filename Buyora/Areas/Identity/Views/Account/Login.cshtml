@model LoginViewModel
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = _localizer["login"];
    bool isResend = ViewBag.ShowResend == true;
}

<div class="buyora-auth-wrapper py-3 py-md-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="buyora-card buyora-auth-card overflow-hidden">
                <div class="row g-0">
                    <div class="col-12 col-lg-5 buyora-auth-visual d-flex flex-column justify-content-between p-4 p-xl-5 text-white position-relative">
                        <div class="position-relative z-2 text-center text-lg-start">
                            <span class="buyora-auth-badge d-inline-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-shield-lock-fill text-buyora-orange"></i>
                                <span>@_localizer["securelogin"]</span>
                            </span>
                            <h3 class="fw-extrabold mb-2">@_localizer["welcomeback"]</h3>
                            <p class="text-white-50 small mb-0">@_localizer["loginsidebarsubtitle"]</p>
                        </div>

                        <div class="buyora-auth-img-stage my-3 position-relative z-2 text-center">
                            <img src="/Login.png" alt="Buyora Login" class="buyora-auth-img img-fluid" />
                        </div>

                        <div class="position-relative z-2">
                            <div class="d-flex align-items-center gap-3 p-3 rounded-4 buyora-auth-perks">
                                <div class="buyora-perk-icon">
                                    <i class="bi bi-bag-check-fill"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 small text-white">@_localizer["fastcheckout"]</h6>
                                    <span class="text-white-50" style="font-size: 0.78rem;">@_localizer["fastcheckoutsub"]</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-7 p-4 p-sm-5 bg-white d-flex flex-column justify-content-center">
                        <div class="mb-4">
                            <h3 class="fw-extrabold text-buyora-blue mb-1">@_localizer["login"]</h3>
                            <p class="text-muted small mb-0">@_localizer["loginsubtitle"]</p>
                        </div>

                        @if (isResend)
                        {
                            <div class="buyora-resend-alert p-3 rounded-4 mb-4 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="buyora-resend-icon">
                                        <i class="bi bi-envelope-exclamation-fill"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-buyora-blue mb-1 small">@_localizer["emailnotconfirmedtitle"]</h6>
                                        <p class="text-muted mb-0" style="font-size: 0.8rem;">@_localizer["emailnotconfirmedsub"]</p>
                                    </div>
                                </div>
                                <form asp-area="Identity"
                                      asp-controller="Account"
                                      asp-action="ReSendConfirmationEmail"
                                      method="post"
                                      class="w-100 w-sm-auto">

                                    <input type="hidden"
                                           name="userEmail"
                                           value="@Model?.Email" />

                                    <button type="submit"
                                            class="btn btn-buyora-accent btn-add-to-cart btn-sm px-3 py-2 d-inline-flex align-items-center justify-content-center gap-2 flex-shrink-0 w-100 w-sm-auto">

                                        <i class="bi bi-send-check-fill cart-btn-icon"></i>

                                        <span class="cart-btn-text">
                                            @_localizer["resendconfirmation"]
                                        </span>

                                    </button>
                                </form>
                            </div>
                        }

                        <form asp-action="Login" method="post" novalidate asp-area="Identity">
                            <input asp-for="ReturnUrl" type="hidden" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small mb-3" role="alert"></div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Email" class="form-label buyora-label">
                                        <i class="bi bi-envelope-fill text-buyora-blue me-1"></i> @_localizer["email"]
                                    </label>
                                    <input type="email" asp-for="Email" class="form-control buyora-input" placeholder="name@example.com" dir="ltr" autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
                                </div>

                                <div class="col-12">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <label asp-for="Password" class="form-label buyora-label mb-0">
                                            <i class="bi bi-lock-fill text-buyora-orange me-1"></i> @_localizer["password"]
                                        </label>
                                        <a asp-action="ForgetPassword" class="small fw-semibold text-buyora-blue text-decoration-none buyora-auth-link">
                                            @_localizer["forgotpassword"]
                                        </a>
                                    </div>
                                    <div class="position-relative">
                                        <input type="password" asp-for="Password" id="loginPassword" class="form-control buyora-input buyora-pass-input" placeholder="••••••••" dir="ltr" autocomplete="current-password" />
                                        <button type="button" class="buyora-pass-toggle" onclick="togglePasswordVisibility('loginPassword', this)" aria-label="Toggle Password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block fw-medium"></span>
                                </div>

                                <div class="col-12">
                                    <div class="buyora-switch-card d-flex align-items-center justify-content-between">
                                        <div>
                                            <label asp-for="RememberMe" class="form-check-label fw-bold text-dark d-block cursor-pointer mb-0">
                                                @_localizer["rememberme"]
                                            </label>
                                            <span class="text-muted" style="font-size: 0.78rem;">@_localizer["remembermesub"]</span>
                                        </div>
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input buyora-switch" type="checkbox" role="switch" asp-for="RememberMe" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 pt-2">
                                    <button type="submit" class="btn btn-buyora-accent btn-add-to-cart w-100 py-3 d-flex align-items-center justify-content-center gap-2 fs-6">
                                        <i class="bi bi-box-arrow-in-right fs-5 cart-btn-icon"></i>
                                        <span class="cart-btn-text">@_localizer["login"]</span>
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="buyora-auth-divider my-3">
                            <span>@_localizer["orcontinuewith"]</span>
                        </div>

                        <form asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@Model?.ReturnUrl" method="post">
                            <button type="submit" class="btn buyora-google-btn w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                                <svg class="buyora-google-icon" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05" />
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335" />
                                </svg>
                                <span>@_localizer["continuewithgoogle"]</span>
                            </button>
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <span class="text-muted small">@_localizer["donthaveaccount"]</span>
                            <a asp-action="Register" class="fw-bold text-buyora-blue text-decoration-none ms-1 buyora-auth-link">
                                @_localizer["createaccount"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}