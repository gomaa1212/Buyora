@model PageResult<GetProductsListViewModel>
@inject IStringLocalizer<SharedResource> _localizer

@if (Model != null && Model.Items.Any())
{
    var startItem = ((Model.Page - 1) * Model.PageSize) + 1;
    var endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var product in Model.Items)
        {
            var hasDiscount = product.DiscountPrice.HasValue && product.DiscountPrice.Value > 0 && product.DiscountPrice.Value < product.Price;
            var discountPercentage = hasDiscount
                ? (int)Math.Round(((product.Price - product.DiscountPrice!.Value) / product.Price) * 100)
                : 0;

            <div class="col">
                <div class="buyora-card buyora-product-card h-100 d-flex flex-column overflow-hidden">
                    <div class="buyora-product-img-wrapper position-relative">
                        @if (hasDiscount)
                        {
                            <span class="buyora-discount-badge">
                                -@discountPercentage% @_localizer["off"]
                            </span>
                        }

                        <div class="buyora-product-actions">
                            <a asp-action="Details" asp-route-id="@product.Id" class="buyora-quick-btn btn-details" title="@_localizer["productdetails"]">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="buyora-quick-btn btn-edit-sm" title="@_localizer["edit"]">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="buyora-quick-btn btn-delete-sm" title="@_localizer["delete"]">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>

                        <a asp-action="Details" asp-route-id="@product.Id" class="d-block h-100">
                            @if (!string.IsNullOrEmpty(product.MainUrl))
                            {
                                <img src="/@product.MainUrl" alt="@product.Name" class="buyora-product-img" />
                            }
                            else
                            {
                                <div class="buyora-no-image d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="bi bi-image text-muted fs-1"></i>
                                    <span class="text-muted small mt-1">@_localizer["noimageavailable"]</span>
                                </div>
                            }
                        </a>
                    </div>

                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <h6 class="buyora-product-title fw-bold mb-2">
                            <a asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                                @product.Name
                            </a>
                        </h6>

                        <div class="mt-auto pt-2">
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                @if (hasDiscount)
                                {
                                    <span class="buyora-price-current">@product.DiscountPrice!.Value.ToString("N2") @_localizer["currency"]</span>
                                    <span class="buyora-price-old text-muted text-decoration-line-through small">@product.Price.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="buyora-price-current">@product.Price.ToString("N2") @_localizer["currency"]</span>
                                }
                            </div>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="m-0">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-buyora-accent btn-add-to-cart w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                                    <i class="bi bi-cart-plus-fill fs-5 cart-btn-icon"></i>
                                    <span class="cart-btn-text">@_localizer["addtocart"]</span>
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="buyora-card buyora-pagination-bar p-3 mt-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="text-muted small fw-semibold">
                <span class="text-buyora-blue fw-bold">@startItem - @endItem</span> / <span class="fw-bold text-dark">@Model.TotalCount</span> @_localizer["products"]
            </div>

            <nav aria-label="Product Pagination">
                <ul class="pagination buyora-pagination mb-0 flex-wrap justify-content-center gap-1">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-categoryName="@Model.CategoryName"
                           asp-route-search="@Model.Search">
                            <i class="bi bi-chevron-left buyora-rtl-flip"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-categoryName="@Model.CategoryName"
                               asp-route-search="@Model.Search">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-categoryName="@Model.CategoryName"
                           asp-route-search="@Model.Search">
                            <i class="bi bi-chevron-right buyora-rtl-flip"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}
else
{
    <div class="buyora-card text-center py-5 px-3">
        <div class="buyora-empty-icon mx-auto mb-3">
            <i class="bi bi-search"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">@_localizer["noproductsfound"]</h5>
        <p class="text-muted small mb-0">@_localizer["noproductsfoundsubtitle"]</p>
    </div>
}