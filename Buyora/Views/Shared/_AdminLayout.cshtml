@using Buyora.Helper
@using Buyora.Resources
@using BuyoraUtility
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> _localizer
@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager

@{
    var isRtl = CultureHelper.IsRightToLeft();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool isSignedIn = _signInManager.IsSignedIn(User);
    bool isAdmin = User.IsInRole("Admin");

    string displayUserName = "";
    string userInitial = "A";

    if (isSignedIn)
    {
        displayUserName = Context.Session.GetString(SD.AppUserName) ?? "";
        if (string.IsNullOrWhiteSpace(displayUserName))
        {
            var currentUser = await _userManager.GetUserAsync(User);
            displayUserName = !string.IsNullOrWhiteSpace(currentUser?.Name)
                ? currentUser.Name
                : (User.Identity?.Name?.Split('@')[0] ?? "Admin");

            Context.Session.SetString(SD.AppUserName, displayUserName);
        }

        userInitial = displayUserName.Trim().Substring(0, 1).ToUpper();
    }
}
<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Buyora Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Buyora.styles.css" asp-append-version="true" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
</head>
<body class="buyora-admin-body buyora-body-with-bottom-nav">

    <div class="buyora-admin-backdrop" id="adminSidebarBackdrop"></div>

    <div class="buyora-admin-layout">
        <aside class="buyora-admin-sidebar d-flex flex-column" id="adminSidebar" aria-label="Admin Sidebar">
            <div class="buyora-sidebar-brand d-flex align-items-center justify-content-between px-4 py-3">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/Logo.png" alt="Buyora" class="buyora-sidebar-logo" />
                    <div>
                        <span class="buyora-sidebar-title d-block">Buyora</span>
                        <span class="buyora-sidebar-badge">@_localizer["adminpanel"]</span>
                    </div>
                </a>
                <button type="button" class="buyora-sidebar-close-btn d-lg-none" id="closeSidebarBtn" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="buyora-sidebar-menu flex-grow-1 px-3 py-3 overflow-auto">
                <div class="buyora-nav-group mb-4">
                    <span class="buyora-nav-group-title px-3 mb-2 d-block">@_localizer["overview"]</span>
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                               class="buyora-sidebar-link @(string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="buyora-sidebar-icon"><i class="bi bi-speedometer2"></i></span>
                                <span>@_localizer["dashboard"]</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="buyora-nav-group mb-4">
                    <span class="buyora-nav-group-title px-3 mb-2 d-block">@_localizer["catalogandsales"]</span>
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                               class="buyora-sidebar-link @(string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "Orders", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="buyora-sidebar-icon"><i class="bi bi-receipt-cutoff"></i></span>
                                <span>@_localizer["orders"]</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" asp-route-from="admin"
                               class="buyora-sidebar-link @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="buyora-sidebar-icon"><i class="bi bi-bag-check-fill"></i></span>
                                <span>@_localizer["products"]</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                               class="buyora-sidebar-link @(string.Equals(currentController, "Category", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="buyora-sidebar-icon"><i class="bi bi-grid-fill"></i></span>
                                <span>@_localizer["categories"]</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="buyora-nav-group">
                    <span class="buyora-nav-group-title px-3 mb-2 d-block">@_localizer["management"]</span>
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="User" asp-action="Index"
                               class="buyora-sidebar-link @(string.Equals(currentController, "User", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "Users", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="buyora-sidebar-icon"><i class="bi bi-people-fill"></i></span>
                                <span>@_localizer["users"]</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="buyora-sidebar-footer p-3">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn buyora-sidebar-store-btn w-100 mb-2 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-shop-window fs-5"></i>
                    <span>@_localizer["store"]</span>
                </a>

                <form asp-area="Identity"
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="w-100 m-0">
                    <button type="submit"
                            class="btn buyora-sidebar-logout-btn w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right fs-5 buyora-rtl-flip"></i>
                        <span>@_localizer["logout"]</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="buyora-admin-main d-flex flex-column min-vh-100">
            <header class="buyora-admin-topbar sticky-top px-3 px-md-4 py-2 d-flex align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2 gap-sm-3 min-w-0">
                    <button type="button" class="btn buyora-sidebar-toggle d-lg-none flex-shrink-0" id="openSidebarBtn" aria-label="Toggle Menu">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <div class="min-w-0">
                        <h5 class="fw-extrabold text-buyora-blue mb-0 text-truncate">@(ViewData["Title"] ?? _localizer["dashboard"])</h5>
                        <span class="text-muted d-none d-sm-block" style="font-size: 0.75rem;">Buyora Control Center</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       class="buyora-topbar-store-pill d-inline-flex align-items-center gap-1"
                       title="@_localizer["store"]">
                        <i class="bi bi-shop-window"></i>
                        <span class="d-none d-md-inline">@_localizer["store"]</span>
                    </a>

                    <div class="language-switcher-wrapper">
                        @await Html.PartialAsync("_SelectLanguagePartial")
                    </div>

                    @if (isSignedIn)
                    {
                        <div class="buyora-profile-badge">
                            <span class="buyora-profile-avatar">
                                @userInitial
                                <span class="buyora-profile-online-dot"></span>
                            </span>
                            <div class="d-none d-sm-flex flex-column justify-content-center lh-1">
                                <span class="buyora-profile-name">@displayUserName</span>
                                <span class="buyora-profile-role mt-1">
                                    @(isAdmin ? _localizer["administrator"] : "Staff")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </header>

            <main role="main" class="buyora-admin-content flex-grow-1 p-3 p-md-4">
                <partial name="_NotificationPartial" />
                @RenderBody()
            </main>

            <footer class="buyora-admin-footer px-4 py-3 mt-auto d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 text-center">
                <span class="text-muted small">
                    &copy; 2026 <strong class="text-buyora-blue">Buyora</strong> Admin Panel
                </span>
                <span class="text-muted small">
                    By <a href="https://www.linkedin.com/in/abdelrahman-mohammed-87445a284/" target="_blank" rel="noopener noreferrer" class="text-buyora-orange fw-bold text-decoration-none">Abdelrahman Mohamed</a>
                </span>
            </footer>
        </div>
    </div>

    <nav class="buyora-mobile-bottom-nav d-lg-none" aria-label="Admin navigation">
        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-speedometer2"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["dashboard"]</span>
        </a>

        <a asp-area="Admin"
           asp-controller="Order"
           asp-action="Index"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "Orders", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-receipt-cutoff"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["orders"]</span>
        </a>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           asp-route-from="admin"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-bag-check-fill"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["products"]</span>
        </a>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "Category", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-grid-fill"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["categories"]</span>
        </a>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Index"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "User", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "Users", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-people-fill"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["users"]</span>
        </a>
    </nav>

    <button type="button" id="buyoraBackToTop" class="buyora-back-to-top" aria-label="Back to top" title="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>

    <script>
            $(function() {
                const $sidebar = $("#adminSidebar");
                const $backdrop = $("#adminSidebarBackdrop");
                const $body = $("body");

                function openSidebar() {
                    $sidebar.addClass("show");
                    $backdrop.addClass("show");
                    $body.css("overflow", "hidden");
                }

                function closeSidebar() {
                    $sidebar.removeClass("show");
                    $backdrop.removeClass("show");
                    $body.css("overflow", "");
                }

                $("#openSidebarBtn").on("click", openSidebar);
                $("#closeSidebarBtn, #adminSidebarBackdrop").on("click", closeSidebar);

                $(document).on("keydown", function(e) {
                    if (e.key === "Escape" && $sidebar.hasClass("show")) {
                        closeSidebar();
                    }
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>