@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <script>
        (function () {
            function showToast() {
                if (typeof toastr !== "undefined") {
                    toastr.options = {
                        closeButton: true,
                        progressBar: true,
                        positionClass: document.documentElement.dir === "rtl" ? "toast-top-left" : "toast-top-right",
                        preventDuplicates: true,
                        showDuration: "300",
                        hideDuration: "1000",
                        timeOut: "4500",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut"
                    };
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <text>toastr.success('@Html.Raw(TempData["SuccessMessage"])');</text>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <text>toastr.error('@Html.Raw(TempData["ErrorMessage"])');</text>
                    }
                } else {
                    setTimeout(showToast, 100);
                }
            }
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", showToast);
            } else {
                showToast();
            }
        })();
    </script>
}

