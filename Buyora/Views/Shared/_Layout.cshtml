
@inject IStringLocalizer<SharedResource> _localizer

@{
    var IsRightToLift = CultureHelper.IsRightToLeft();
}
<!DOCTYPE html>
<html lang="@(IsRightToLift ? "ar" : "en")" dir="@(IsRightToLift ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Buyora</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @if (IsRightToLift)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Buyora.styles.css" asp-append-version="true" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg buyora-navbar py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 m-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Logo.png" alt="Buyora" class="buyora-logo" />
                    <span class="brand-title">Buyora</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#buyoraMainNavbar" aria-controls="buyoraMainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="buyoraMainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2 pt-3 pt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link buyora-nav-link"  asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> @_localizer["home"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link buyora-nav-link"  asp-controller="Category" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> @_localizer["categories"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link buyora-nav-link"  asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1"></i> @_localizer["privacy"]
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center justify-content-between justify-content-lg-end gap-3 pt-2 pt-lg-0 border-top border-lg-0 mt-2 mt-lg-0">
                        <div class="language-switcher-wrapper">
                            @await Html.PartialAsync("_SelectLanguagePartial")
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main" class="pb-4">
            <partial name="_NotificationPartial" />
            @RenderBody()
        </main>
    </div>

    <footer class="buyora-footer mt-auto">
        <div class="container py-4">
            <div class="row gy-3 align-items-center justify-content-between text-center text-md-start">
                <div class="col-12 col-md-6 d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-md-start gap-3">
                    <img src="~/Logo.png" alt="Buyora" class="footer-logo" />
                    <div>
                        <h6 class="text-white fw-bold mb-1">Buyora</h6>
                        <p class="footer-slogan mb-0">Shop Smarter. Live Better.</p>
                    </div>
                </div>
                <div class="col-12 col-md-6 text-center text-md-end">
                    <p class="mb-0 footer-copy">
                        &copy; 2026 - <span class="text-white fw-semibold">Buyora</span> - By <span class="text-buyora-orange fw-semibold">Abdelrahman Mohamed</span>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>