@using Buyora.Helper
@using Buyora.Resources
@using BuyoraBusiness.Services.Interfaces
@using BuyoraUtility
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject UserManager<ApplicationUser> _userManager
@inject SignInManager<ApplicationUser> _signInManager
@inject IShoppingCartService _shoppingCartService
@inject IStringLocalizer<SharedResource> _localizer

@{
    var IsRightToLift = CultureHelper.IsRightToLeft();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isSignedIn = _signInManager.IsSignedIn(User);
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Employee");

    string displayUserName = "";
    string userInitial = "U";

    if (isSignedIn)
    {
        displayUserName = Context.Session.GetString(SD.AppUserName) ?? "";
        if (string.IsNullOrWhiteSpace(displayUserName))
        {
            var currentUser = await _userManager.GetUserAsync(User);
            displayUserName = !string.IsNullOrWhiteSpace(currentUser?.Name)
                ? currentUser.Name
                : (User.Identity?.Name?.Split('@')[0] ?? "User");

            Context.Session.SetString(SD.AppUserName, displayUserName);
        }

        userInitial = displayUserName.Trim().Substring(0, 1).ToUpper();
    }
}
<!DOCTYPE html>
<html lang="@(IsRightToLift ? "ar" : "en")" dir="@(IsRightToLift ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Buyora</title>
    <link rel="icon" type="image/png" href="~/Logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/Logo.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @if (IsRightToLift)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Buyora.styles.css" asp-append-version="true" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100 buyora-body-with-bottom-nav">

    <div class="buyora-topbar d-none d-lg-block">
        <div class="container d-flex align-items-center justify-content-between py-1">
            <div class="d-flex align-items-center gap-3">
                <span class="buyora-topbar-item">
                    <i class="bi bi-patch-check-fill text-buyora-orange"></i>
                    <span>100% @_localizer["originalproducts"]</span>
                </span>
                <span class="buyora-topbar-divider">|</span>
                <span class="buyora-topbar-item">
                    <i class="bi bi-truck text-buyora-orange"></i>
                    <span>@_localizer["fastdelivery"]</span>
                </span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="buyora-topbar-item">
                    <i class="bi bi-headset text-buyora-orange"></i>
                    <span>@_localizer["support247"]</span>
                </span>
            </div>
        </div>
    </div>

    <header class="sticky-top buyora-header-wrap">
        <nav class="navbar navbar-expand-lg buyora-navbar py-2">
            <div class="container gap-2">
                <a class="navbar-brand d-flex align-items-center gap-2 m-0 flex-shrink-0"
                   asp-area="Customer" asp-controller="Home" asp-action="Index">
                    <img src="~/Logo.png" alt="Buyora" class="buyora-logo" />
                    <span class="brand-title">Buyora</span>
                </a>

                <div class="d-flex align-items-center gap-2 d-lg-none ms-auto">
                    @await Html.PartialAsync("_SelectLanguagePartial")
                    @await Component.InvokeAsync("CartCount")
                    <button class="navbar-toggler buyora-navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#buyoraMainNavbar"
                            aria-controls="buyoraMainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="buyoraMainNavbar">
                    <ul class="navbar-nav ms-lg-2 me-lg-2 mb-2 mb-lg-0 gap-lg-1 pt-3 pt-lg-0 flex-shrink-0">
                        <li class="nav-item">
                            <a class="nav-link buyora-nav-link @(string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-area="Customer" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                <span>@_localizer["home"]</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link buyora-nav-link @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-area="Customer" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-bag-check"></i>
                                <span>@_localizer["products"]</span>
                            </a>
                        </li>
                        @if (isSignedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link buyora-nav-link @(string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-area="Customer" asp-controller="Order" asp-action="Index">
                                    <i class="bi bi-receipt-cutoff"></i>
                                    <span>@_localizer["myorders"]</span>
                                </a>
                            </li>
                        }
                    </ul>

                    <form asp-area="Customer"
                          asp-controller="Product"
                          asp-action="Index"
                          method="get"
                          class="buyora-nav-search flex-grow-1 my-2 my-lg-0 mx-lg-2">
                        <div class="buyora-nav-search-box">
                            <i class="bi bi-search buyora-nav-search-icon"></i>
                            <input type="search"
                                   name="search"
                                   value="@Context.Request.Query["search"]"
                                   class="form-control buyora-nav-search-input"
                                   placeholder="@_localizer["searchproductsplaceholder"]"
                                   autocomplete="off" />
                            <button type="submit" class="buyora-nav-search-submit" aria-label="Search">
                                <i class="bi bi-arrow-right-short buyora-rtl-flip"></i>
                            </button>
                        </div>
                    </form>

                    <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 pt-2 pt-lg-0 border-top border-lg-0 mt-2 mt-lg-0 ms-lg-auto flex-shrink-0">
                        @if (isStaff)
                        {
                            <a asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn buyora-nav-admin-btn d-inline-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-speedometer2"></i>
                                <span>@_localizer["dashboard"]</span>
                            </a>
                        }

                        <div class="d-none d-lg-block">
                            @await Component.InvokeAsync("CartCount")
                        </div>

                        @if (isSignedIn)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="buyora-profile-badge">
                                    <span class="buyora-profile-avatar">
                                        @userInitial
                                        <span class="buyora-profile-online-dot"></span>
                                    </span>
                                    <span class="buyora-profile-name">@displayUserName</span>
                                </div>

                                <form asp-area="Identity"
                                      asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline m-0">
                                    <button type="submit"
                                            class="btn buyora-nav-logout-btn d-inline-flex align-items-center justify-content-center gap-1"
                                            title="@_localizer["logout"]">
                                        <i class="bi bi-box-arrow-right buyora-rtl-flip"></i>
                                        <span class="d-lg-none d-xxl-inline">@_localizer["logout"]</span>
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a class="btn buyora-btn-outline btn-sm py-2 px-3 d-inline-flex align-items-center justify-content-center gap-1"
                               asp-area="Identity" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right buyora-rtl-flip"></i>
                                <span>@_localizer["login"]</span>
                            </a>
                        }

                        <div class="d-none d-lg-flex align-items-center">
                            @await Html.PartialAsync("_SelectLanguagePartial")
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main" class="pb-4">
            <partial name="_NotificationPartial" />
            @RenderBody()
        </main>
    </div>

    <nav class="buyora-mobile-bottom-nav d-lg-none" aria-label="Mobile Navigation">
        <a asp-area="Customer"
           asp-controller="Home"
           asp-action="Index"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi @(string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) ? "bi-house-door-fill" : "bi-house-door")"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["home"]</span>
        </a>

        <a asp-area="Customer"
           asp-controller="Product"
           asp-action="Index"
           class="buyora-bottom-nav-item @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) ? "bi-bag-check-fill" : "bi-bag-check")"></i>
            <span class="buyora-bottom-nav-label text-truncate">@_localizer["products"]</span>
        </a>

        <div class="buyora-bottom-nav-item buyora-bottom-nav-cart @(string.Equals(currentController, "Cart", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            @await Component.InvokeAsync("CartCount")
            <span class="buyora-bottom-cart-label buyora-bottom-nav-label text-truncate">@_localizer["shoppingcart"]</span>
        </div>

        @if (isStaff)
        {
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="buyora-bottom-nav-item @(string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-speedometer2"></i>
                <span class="buyora-bottom-nav-label text-truncate">@_localizer["dashboard"]</span>
            </a>

            <a asp-area="Customer"
               asp-controller="Order"
               asp-action="Index"
               class="buyora-bottom-nav-item @(string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-receipt-cutoff"></i>
                <span class="buyora-bottom-nav-label text-truncate">@_localizer["myorders"]</span>
            </a>
        }
        else if (isSignedIn)
        {
            <a asp-area="Customer"
               asp-controller="Order"
               asp-action="Index"
               class="buyora-bottom-nav-item @(string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi @(string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase) ? "bi-receipt-cutoff" : "bi-receipt")"></i>
                <span class="buyora-bottom-nav-label text-truncate">@_localizer["myorders"]</span>
            </a>

            <button type="button"
                    class="buyora-bottom-nav-item border-0 bg-transparent js-mobile-user-toggle"
                    data-bs-toggle="collapse"
                    data-bs-target="#buyoraMainNavbar"
                    aria-controls="buyoraMainNavbar"
                    aria-expanded="false"
                    aria-label="@displayUserName">
                <i class="bi bi-person-circle"></i>
                <span class="buyora-bottom-nav-label text-truncate">@displayUserName</span>
            </button>
        }
        else
        {
            <a asp-area="Identity"
               asp-controller="Account"
               asp-action="Login"
               class="buyora-bottom-nav-item @(string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-person-circle"></i>
                <span class="buyora-bottom-nav-label text-truncate">@_localizer["login"]</span>
            </a>
        }
    </nav>

    <button type="button" id="buyoraBackToTop" class="buyora-back-to-top" aria-label="Back to top" title="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <partial name="_CustomerChatWidget" />

    <footer class="buyora-footer mt-auto">
        <div class="container pt-5 pb-4">
            <div class="row g-4 justify-content-between pb-4 border-bottom border-light border-opacity-10">
                <div class="col-12 col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="~/Logo.png" alt="Buyora" class="footer-logo" />
                        <div>
                            <h5 class="text-white fw-extrabold mb-0">Buyora</h5>
                            <span class="footer-slogan">Shop Smarter. Live Better.</span>
                        </div>
                    </div>
                    <p class="footer-desc mb-3">
                        @_localizer["herosubtitle"]
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <a href="https://github.com/gomaa1212" target="_blank" rel="noopener noreferrer" class="buyora-social-link social-github" title="GitHub" aria-label="GitHub"><i class="bi bi-github"></i></a>
                        <a href="https://www.linkedin.com/in/abdelrahman-mohammed-87445a284/" target="_blank" rel="noopener noreferrer" class="buyora-social-link social-linkedin" title="LinkedIn" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://wa.me/201110974940" target="_blank" rel="noopener noreferrer" class="buyora-social-link social-whatsapp" title="WhatsApp: 01110974940" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        <a href="https://khamsat.com/user/abdo_mo76" target="_blank" rel="noopener noreferrer" class="buyora-social-link social-khamsat" title="خمسات | Khamsat" aria-label="Khamsat"><i class="bi bi-briefcase-fill"></i></a>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="buyora-footer-heading mb-3">@_localizer["explore"]</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li>
                            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="buyora-footer-link">
                                @_localizer["home"]
                            </a>
                        </li>
                        <li>
                            <a asp-area="Customer" asp-controller="Product" asp-action="Index" class="buyora-footer-link">
                                @_localizer["products"]
                            </a>
                        </li>
                        <li>
                            <a asp-area="Customer" asp-controller="Order" asp-action="Index" class="buyora-footer-link">
                                @_localizer["myorders"]
                            </a>
                        </li>
                        <li>
                            <a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="buyora-footer-link">
                                @_localizer["shoppingcart"]
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-6 col-md-4 col-lg-3">
                    <h6 class="buyora-footer-heading mb-3">@_localizer["customersupport"]</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li class="buyora-footer-info">
                            <i class="bi bi-shield-check text-buyora-orange"></i>
                            <span>@_localizer["securepayment"]</span>
                        </li>
                        <li class="buyora-footer-info">
                            <i class="bi bi-truck text-buyora-orange"></i>
                            <span>@_localizer["fastdelivery"]</span>
                        </li>
                        <li class="buyora-footer-info">
                            <i class="bi bi-arrow-repeat text-buyora-orange"></i>
                            <span>@_localizer["easyreturns"]</span>
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-md-4 col-lg-3">
                    <h6 class="buyora-footer-heading mb-3">@_localizer["securepayment"]</h6>
                    <p class="footer-desc small mb-3">@_localizer["securepaymentsub"]</p>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="buyora-pay-badge"><i class="bi bi-credit-card-2-front me-1"></i> Visa</span>
                        <span class="buyora-pay-badge"><i class="bi bi-credit-card me-1"></i> MasterCard</span>
                        <span class="buyora-pay-badge"><i class="bi bi-cash-stack me-1"></i> Cash</span>
                    </div>
                </div>
            </div>

            <div class="row gy-2 align-items-center justify-content-between pt-3 text-center text-md-start">
                <div class="col-12 col-md-6">
                    <p class="mb-0 footer-copy">
                        &copy; 2026 <span class="text-white fw-bold">Buyora</span>. All Rights Reserved.
                    </p>
                </div>
                <div class="col-12 col-md-6 text-center text-md-end">
                    <p class="mb-0 footer-copy">
                        Developed by <a href="https://www.linkedin.com/in/abdelrahman-mohammed-87445a284/" target="_blank" rel="noopener noreferrer" class="text-buyora-orange fw-bold text-decoration-none">Abdelrahman Mohamed</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/buyora-chat.js" asp-append-version="true"></script>
    <script>
            $(function() {
                const loginUrl = '@Url.Action("Login", "Account", new { area = "Identity" })';

                $(document).on("submit", ".js-add-to-cart-form, form[action*='AddToCart']", function(e) {
                    e.preventDefault();

                    const $form = $(this);
                    const $btn = $form.find("button[type='submit']");
                    const $icon = $btn.find(".cart-btn-icon");
                    const addedCount = parseInt($form.find("input[name='count']").val()) || 1;

                    if ($btn.prop("disabled")) return;
                    $btn.prop("disabled", true);
                    $icon.removeClass("bi-cart-plus-fill").addClass("spinner-border spinner-border-sm");

                    $.ajax({
                        url: $form.attr("action"),
                        type: "POST",
                        data: $form.serialize(),
                        success: function(response) {
                            if (response && response.success) {
                                $icon.removeClass("spinner-border spinner-border-sm").addClass("bi-check2 text-white");
                                
                                const $cartBadges = $(".js-cart-count");
                                $cartBadges.each(function() {
                                    const $badge = $(this);
                                    const currentVal = parseInt($badge.text().trim()) || 0;
                                    const nextVal = (response.cartCount !== undefined) ? response.cartCount : (currentVal + addedCount);
                                    $badge.text(nextVal).removeClass("d-none").addClass("buyora-badge-pop");
                                    setTimeout(function() {
                                        $badge.removeClass("buyora-badge-pop");
                                    }, 400);
                                });

                                if (typeof toastr !== "undefined") {
                                    toastr.success(response.message || "Product added to cart successfully.");
                                }

                                setTimeout(function() {
                                    $icon.removeClass("bi-check2 text-white").addClass("bi-cart-plus-fill");
                                }, 900);
                            }
                        },
                        error: function(xhr) {
                            const errMsg = xhr.responseJSON?.message || "Failed to add product to cart.";
                            if (xhr.status === 401) {
                                if (typeof toastr !== "undefined") {
                                    toastr.warning(errMsg);
                                }
                                setTimeout(function() {
                                    window.location.href = loginUrl + "?ReturnUrl=" + encodeURIComponent(window.location.pathname + window.location.search);
                                }, 900);
                            } else {
                                if (typeof toastr !== "undefined") {
                                    toastr.error(errMsg);
                                }
                            }
                        },
                        complete: function() {
                            $btn.prop("disabled", false);
                            $icon.removeClass("spinner-border spinner-border-sm").addClass("bi-cart-plus-fill");
                        }
                    });
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
